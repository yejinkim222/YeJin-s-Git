# 기본 프로바이더는 (ollama/gemini 중 택1)
GENAI_PROVIDER=ollama

# --- 샘플링/길이 ---
GENAI_MAX_NEW_TOKENS=200
GENAI_TEMPERATURE=0.2
GENAI_TOP_P=0.85


#  Gemini는 폴백/병행 시에만 사용
# GOOGLE_API_KEY=***실제키***
GEMINI_MODEL=gemini-1.5-flash

# --- RAG config ---
RAG_ENABLED=True
RAG_TOP_K=3

RAG_ALLOW_HOSTS=riss.kr,dbpia.co.kr,nl.go.kr,nanet.go.kr,scienceon.kisti.re.kr
RAG_SEED_URLS=https://www.nhis.or.kr/nhis/index.do,https://scienceon.kisti.re.kr/main/mainForm.do
RAG_CRAWL_DEPTH=1
RAG_MAX_PAGES_PER_HOST=20
RAG_RESPECT_ROBOTS=true
RAG_RATE_LIMIT_PER_HOST=0.5   # 초당 2회 요청

RAG_CHROMA_COLLECTION=solcare_rag

# RAG 저장소(선택: 안 주면 pybo/data/rag/chroma 사용)
RAG_CHROMA_DIR=C:/Flask_solcare/flask_basic/pybo/data/rag/chroma

# PDF 폴더 (지금 올려둔 2개 PDF가 있는 곳)
RAG_PDF_DIR=pybo/data/solcare_pdf

# 임베딩/청킹
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_PREVIEW_N=100

# RAG 켜기 (봇에서 RAG 사용)
BOT_RAG_MODE=true
# true면 Agent(툴 호출) 사용
BOT_AGENT_MODE=true
# true면 외부 웹 검색 허용
AGENT_WEB_SEARCH=false

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q5_K_M
